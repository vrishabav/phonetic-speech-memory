# Copy to .env. Never commit .env.
#
# NOTHING HERE IS REQUIRED. `make serve`, `make eval` and `make test` all run
# with no .env at all, no key and no network. Credentials are only needed to
# run `make eval-live` or to record new cassettes.

# --- live model access (optional) ------------------------------------------
# Only `make eval-live` needs this. Without it the live adapter refuses to
# construct rather than silently degrading to the offline stub, because a run
# that quietly fell back would report "0 model calls" and look like a triumph
# of efficiency.
SARVAM_API_KEY=

# The endpoint and model are configuration rather than constants, so the same
# adapter drives any OpenAI-compatible endpoint. Defaults are in config.py.
# PSM_SARVAM_BASE_URL=https://api.sarvam.ai/v1
# PSM_SARVAM_MODEL=sarvam-105b

# --- component selection ----------------------------------------------------
# Any value may also be a dotted path ("package.module:ClassName"). The full
# alias list is in src/psm/registry.py, and a test asserts that every alias
# resolves and that the engine actually honours what is set here.
PSM_LLM=llm.stub
PSM_FORMATTER=formatter.passthrough
PSM_CLOCK=clock.system
PSM_PHONETICS=phonetics.dmetaphone
PSM_STORE=store.sqlite
PSM_INDEX=index.inmemory

# Comma-separated, ordered. Removing a name is how an ablation is expressed;
# the committed ablation results were produced this way, not by editing code.
# PSM_POLICIES=suppression,verbatim,already_canonical,script_fit,scope_fit,exact_variant,phonetic,common_word_guard,cooccurrence,conflict,recency

# --- infrastructure ---------------------------------------------------------
PSM_DATABASE_URL=sqlite:///./data/psm.db
PSM_CASSETTE_DIR=evals/cassettes
