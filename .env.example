# Copy to .env. Never commit .env.
#
# NOTHING HERE IS REQUIRED. `make serve`, `make eval` and `make test` all run
# with no .env at all, no key and no network. A key is only needed to run
# `make eval-live` or to record new cassettes.

# --- model access -----------------------------------------------------------
SARVAM_API_KEY=

# --- component selection ----------------------------------------------------
# Any value may also be a dotted path ("package.module:ClassName"). The full
# alias list is in src/lmh/registry.py, and a test asserts that every alias
# resolves and that the engine actually honours what is set here.
LMH_LLM=llm.stub
LMH_FORMATTER=formatter.passthrough
LMH_CLOCK=clock.system
LMH_PHONETICS=phonetics.dmetaphone
LMH_STORE=store.sqlite
LMH_INDEX=index.inmemory

# Comma-separated, ordered. Removing a name is how an ablation is expressed;
# the committed ablation results were produced this way, not by editing code.
# LMH_POLICIES=suppression,verbatim,already_canonical,script_fit,scope_fit,exact_variant,phonetic,common_word_guard,cooccurrence,conflict,recency

# --- infrastructure ---------------------------------------------------------
LMH_DATABASE_URL=sqlite:///./data/lmh.db
LMH_CASSETTE_DIR=evals/cassettes
LMH_SARVAM_BASE_URL=https://api.sarvam.ai/v1
LMH_SARVAM_MODEL=sarvam-105b
